<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="BusNova_System.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>BusNova System Management</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="Styles/Home.css?v=4" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        
        <div> 
            <!-- ===================================== -->
            <!-- NAVIGATION BAR -->
            <!-- ===================================== -->

            <nav class="navbar navbar-expand-lg navbar-light custom-navbar fixed-top">

                <div class="container">

                    <!-- Logo -->

                    <a class="navbar-brand d-flex align-items-center" href="Home.aspx">

                        <img src="Images/logo.jpeg" alt="Logo" class="logo-img" />

                        <span class="system-name">
                            BusNova System Management
                        </span>

                    </a>

                    <!-- Mobile Menu Button -->

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarMenu">

                        <span class="navbar-toggler-icon"></span>

                    </button>

                    <!-- Navigation Links -->

                    <div class="collapse navbar-collapse justify-content-end"
                         id="navbarMenu">

                        <ul class="navbar-nav align-items-lg-center">

                            <li class="nav-item">
                                <a class="<%= GetNavClass("Home.aspx") %>" href="Home.aspx">
                                    <i class="fas fa-home"></i>
                                    Home
                                </a>
                            </li>

                            <%-- Signed OUT: Login and Register only. --%>
                            <asp:PlaceHolder ID="phAnonymous" runat="server">

                                <li class="nav-item">
                                    <a class="<%= GetNavClass("Login.aspx") %>" href="Login.aspx">
                                        <i class="fas fa-sign-in-alt"></i>
                                        Login
                                    </a>
                                </li>

                                <li class="nav-item ms-3">
                                    <a class="btn btn-primary register-btn" href="Register.aspx">
                                        <i class="fas fa-user-plus"></i>
                                        Register
                                    </a>
                                </li>

                            </asp:PlaceHolder>

                            <%-- Fleet Manager --%>
                            <asp:PlaceHolder ID="phFleetManager" runat="server" Visible="false">

                                <li class="nav-item">
                                    <a class="<%= GetNavClass("Dashboard.aspx") %>" href="Dashboard.aspx">
                                        <i class="fas fa-gauge"></i>
                                        Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="<%= GetNavClass("RegisterBus.aspx") %>" href="RegisterBus.aspx">
                                        <i class="fas fa-bus"></i>
                                        Register Bus
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="<%= GetNavClass("CreateRoute.aspx") %>" href="CreateRoute.aspx">
                                        <i class="fas fa-route"></i>
                                        Create Route
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="<%= GetNavClass("AssignRoute.aspx") %>" href="AssignRoute.aspx">
                                        <i class="fas fa-calendar-check"></i>
                                        Assign Route
                                    </a>
                                </li>

                            </asp:PlaceHolder>

                            <%-- Bus Driver --%>
                            <asp:PlaceHolder ID="phDriver" runat="server" Visible="false">

                                <li class="nav-item">
                                    <a class="<%= GetNavClass("Dashboard.aspx") %>" href="Dashboard.aspx">
                                        <i class="fas fa-gauge"></i>
                                        Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="<%= GetNavClass("ViewAssignedRoutes.aspx") %>" href="ViewAssignedRoutes.aspx">
                                        <i class="fas fa-calendar-days"></i>
                                        My Schedule
                                    </a>
                                </li>

                            </asp:PlaceHolder>

                            <%-- Maintenance Staff and Passenger currently have the
                                 dashboard only. Their operational screens arrive
                                 in the next iteration. --%>
                            <asp:PlaceHolder ID="phOtherRoles" runat="server" Visible="false">

                                <li class="nav-item">
                                    <a class="<%= GetNavClass("Dashboard.aspx") %>" href="Dashboard.aspx">
                                        <i class="fas fa-gauge"></i>
                                        Dashboard
                                    </a>
                                </li>

                            </asp:PlaceHolder>

                            <%-- Signed IN: who you are, and how to leave. --%>
                            <asp:PlaceHolder ID="phSignedIn" runat="server" Visible="false">

                                <li class="nav-item ms-lg-3">
                                    <span class="nav-link" style="color:#55607A; cursor:default;">
                                        <i class="fas fa-user"></i>
                                        <asp:Literal ID="litUserName" runat="server" />
                                        <span style="opacity:.7;">(<asp:Literal ID="litUserRole" runat="server" />)</span>
                                    </span>
                                </li>

                                <li class="nav-item ms-lg-2">
                                    <a class="btn btn-primary register-btn" href="Logout.aspx">
                                        <i class="fas fa-sign-out-alt"></i>
                                        Sign out
                                    </a>
                                </li>

                            </asp:PlaceHolder>

                        </ul>

                    </div>

                </div>

            </nav>
                
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
            <!-- ===================================== -->
            <!-- FOOTER -->
            <!-- ===================================== -->

            <footer class="footer">

                <div class="container">

                    <div class="row">

                        <!-- About -->
                        <div class="col-lg-4 col-md-6">

                            <h4>BusNova System Management</h4>

                            <p>
                                A modern transport management platform designed to
                                improve public transport operations through efficient
                                fleet management, route planning and passenger services.
                            </p>

                        </div>

                        <!-- Quick Links -->
                        <div class="col-lg-4 col-md-6">

                            <h4>Quick Links</h4>

                            <ul class="footer-links">

                                <li>
                                    <a href="#">About</a>
                                </li>

                                <li>
                                    <a href="#">Contact Us</a>
                                </li>

                                <li>
                                    <a href="#">Help Centre</a>
                                </li>

                                <li>
                                    <a href="#">Privacy Policy</a>
                                </li>

                                <li>
                                    <a href="#">Terms &amp; Conditions</a>
                                </li>

                            </ul>

                        </div>

                        <!-- Contact -->
                        <div class="col-lg-4 col-md-12">

                            <h4>Contact Us</h4>

                            <p>

                                <i class="fas fa-map-marker-alt"></i>
                                Forte Town, South Africa

                            </p>

                            <p>

                                <i class="fas fa-envelope"></i>
                                support@busnova.co.za

                            </p>

                            <p>

                                <i class="fas fa-phone"></i>
                                +27 43 123 4567

                            </p>

                            <div class="social-icons">

                                <a href="#">
                                    <i class="fab fa-facebook-f"></i>
                                </a>

                                <a href="#">
                                    <i class="fab fa-twitter"></i>
                                </a>

                                <a href="#">
                                    <i class="fab fa-instagram"></i>
                                </a>

                                <a href="#">
                                    <i class="fab fa-linkedin-in"></i>
                                </a>

                            </div>

                        </div>

                    </div>

                    <hr />

                    <div class="footer-bottom">

                        <p>

                            Copyright © 2026 BusNova System Management.
                            All Rights Reserved.

                        </p>

                    </div>

                </div>

            </footer>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    Deliberately does NOT define a BusNovaDb connection string. Every test
    in this project exercises pure logic (hashing, formatting, config
    parsing) that never calls DataAccess.Db, so there is nothing to point
    at a database. If a future test needs one, add it here pointing at a
    disposable test database - never the real BusNovaDB.
  -->
  <appSettings>
    <!-- Matches the value TicketPricingTests asserts against. -->
    <add key="BusNova:TicketPrice" value="200.00" />
  </appSettings>
</configuration>
